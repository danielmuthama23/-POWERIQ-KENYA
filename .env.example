# Copy to .env. Never commit real values.
POWERIQ_ENV=local                 # 'production' refuses to start without POWERIQ_API_KEYS
# key:role pairs, roles = viewer | analyst | approver. Leave empty in local mode to use the documented demo keys.
POWERIQ_API_KEYS=
POWERIQ_RATE_LIMIT=240            # requests per minute per key
POWERIQ_AUDIT_DB=/data/audit.db
POWERIQ_CORS=http://localhost:5173
# Optional: enables the OpenAI-written copilot narrative (backend only; falls back to a local template on failure)
OPENAI_API_KEY=
POWERIQ_OPENAI_MODEL=gpt-4o-mini
